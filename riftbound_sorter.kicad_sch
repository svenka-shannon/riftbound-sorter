  (text "GPIO13 (33) <- home switch: C to GND (pin 30), NC to GPIO13, NO unused; internal pull-up. config/machine.json elevator TOP_SWITCH_NC / BOTTOM_SWITCH_NC = true" (at 30 50 0)
